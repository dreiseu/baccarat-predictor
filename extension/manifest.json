{
  "manifest_version": 3,
  "name": "Shoe Odds Calculator",
  "version": "1.0.0",
  "description": "Exact next-hand baccarat odds from the cards you enter, in Chrome's side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Shoe Odds Calculator",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
